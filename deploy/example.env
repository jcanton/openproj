# One deployment of openproj, described. `gcloud_deploy.sh <this file>` reads it;
# `openproj init` writes it when asked. It lives in the plan repository, beside the
# plan it deploys, so the tool's own source names no deployment.
#
# Every value here is a name or a public identifier. The two secrets — the App's
# private key and the OAuth client secret — go into Secret Manager at deploy time
# and are never in this file.
# Google Cloud project ID — the short string `gcloud projects list` prints under
# PROJECT_ID, not the display name and not the number. Billing has to be enabled
# on it: Cloud Run, Cloud Build and Artifact Registry all refuse without it, free
# tier included.
PROJECT=""

# A Tier 1 region, which is what Cloud Run's always-free allowance applies to.
# Changing it changes the service URL, and with it the OAuth App's redirect URIs.
REGION="europe-west1"

# The Cloud Run service name; it becomes part of the URL.
SERVICE="openproj"

# The plan repository the service clones on boot, serves, and pushes every
# save to. An https URL; the credential is the GitHub App below.
REMOTE=""

# The GitHub org whose membership decides who may write.
ORG=""

# The GitHub App the server writes with — its ID, from the App's settings page.
# Not a secret.
APP_ID=""

# The number at the end of the URL when you open the App's installation on the
# plan repository. Not a secret.
INSTALLATION_ID=""

# The OAuth App a person signs in through — its client ID. The client SECRET is
# asked for at the deploy prompt and goes straight into Secret Manager; it is
# never written to a file.
OAUTH_CLIENT_ID=""

# Path on this machine to the GitHub App's private key. Read once into Secret
# Manager by the deploy; the file can be deleted afterwards.
APP_KEY_FILE=""
